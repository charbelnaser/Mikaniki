# --- App ---
APP_NAME=Mikaniki
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:4200

# --- Database ---
# SQLite for local dev. For Postgres: postgresql+psycopg://user:pass@host:5432/mikaniki (and pip install psycopg[binary])
DATABASE_URL=sqlite:///./mikaniki.db

# --- LLM provider: claude | openai | mock ---
# "mock" returns canned answers so you can develop the UI without an API key.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LLM_MAX_TOKENS=4000

# Optional: embedded repair videos in the chat (YouTube Data API v3 key, free quota ~100 searches/day).
# Without it the chat links to a YouTube search instead.
YOUTUBE_API_KEY=

# Part photos from Wikimedia Commons: their API blocks requests without a contact (email or website).
WIKIMEDIA_CONTACT=

# Optional: 17VIN (https://en.17vin.com, paid per successful result) decodes the European/Chinese
# VINs that NHTSA vPIC cannot. API access must be enabled on the account. Leave empty to disable.
VIN17_USER=
VIN17_PASSWORD=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
